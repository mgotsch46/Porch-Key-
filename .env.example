# ── Copy to .env for local dev. On Railway, set these under Variables. ──

# REQUIRED IN PRODUCTION ───────────────────────────────────────────────
# Keeps login sessions valid across restarts. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# Where the database and uploaded documents live. On Railway, mount a
# persistent volume and point this at it, or your data resets on redeploy.
DATA_DIR=/data

# Your public URL, used for Stripe redirects back into the app.
BASE_URL=https://your-app.up.railway.app

# FIRST-RUN SEED (only used when the database is empty) ────────────────
COMPANY_NAME=My Company
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=ChangeMeNow123!

# Platform super admin — optional, lets you manage all companies.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Set to false to stop new companies signing themselves up.
SIGNUPS_OPEN=true

# PAYMENTS: STRIPE ────────────────────────────────────────────────────
# Card, bank transfer (ACH), and Cash App Pay. Use sk_test_… while testing.
STRIPE_SECRET_KEY=
# From the Stripe dashboard after adding the webhook endpoint:
#   https://your-app.up.railway.app/api/stripe/webhook   (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=

# PAYMENTS: PAYNEARME (cash at Walmart, 7-Eleven, CVS…) ────────────────
# Apply at paynearme.com. Until these are set, buyers get an internal code
# that you mark paid manually when cash arrives.
PNM_API_KEY=
PNM_SITE_ID=
PNM_WEBHOOK_SECRET=
# Their callback URL: https://your-app.up.railway.app/api/paynearme/webhook

# AI DOCUMENT READING ─────────────────────────────────────────────────
# Reads closing docs to prefill loans, and bank/card statements for expenses.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# SERVICING BEHAVIOR ──────────────────────────────────────────────────
# Days past due before a late notice escalates to a notice of default.
LEGAL_NOTICE_DAYS=15
# Bump this whenever you change the Terms/Privacy text — every buyer
# is then re-prompted to accept the new version.
TERMS_VERSION=2026-08-09
